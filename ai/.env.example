# Settings for the LangGraph graphs and the ingestion/voice packages in ai/.
# Copy to ai/.env and fill in the placeholders. Never commit ai/.env.

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REASONING_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_EMBED_DIM=768

# PostgreSQL (the same local database as local/.env)
DB_NAME=workweave
PORT=5432
PASS=change-me-local-only

# Optional: Google Calendar for the Work Companion (google_calendar_auth.py on port 8001).
# Create an OAuth client in your own Google Cloud project.
GOOGLE_CLIENT_ID=your-oauth-client-id
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/callback
# The calendar used for local testing (one calendar for every session until it's per employee).
WORKWEAVE_EMPLOYEE_EMAIL=you@example.com
