{
  "name": "workweave-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WorkWeave frontend UI preview (static export). Fixture client only; no backend or AI wiring.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "NEXT_PUBLIC_WORKWEAVE_MODE=http next dev --port ${PORT:-3000}",
    "dev:preview": "next dev --port ${PORT:-3000}",
    "dev:stack": "node scripts/dev-stack.mjs",
    "build": "next build",
    "serve": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "build:http": "NEXT_PUBLIC_WORKWEAVE_MODE=http next build",
    "serve:http": "STATIC_ROOT=out-http API_ORIGIN=${API_ORIGIN:-http://127.0.0.1:8000} PORT=${PORT:-4319} node scripts/serve-static.mjs",
    "e2e:http": "playwright test -c playwright.http.config.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
