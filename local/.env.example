# Local development settings for Docker Compose and the backend (backend/app/config.py reads this file).
# Copy to local/.env and fill in the placeholders. Never commit local/.env.
# These values are for a local machine only; the cloud environment gets its settings from Terraform/Secret Manager.

# PostgreSQL (local/compose.yaml)
POSTGRES_DB=workweave
POSTGRES_USER=workweave
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Gemini Developer API key, used locally for voice (listening and read-aloud).
GEMINI_API_KEY=your-gemini-api-key

# AI engines: the LangGraph graphs in ai/, each run with `langgraph dev` (see README.md).
TUTOR_ENGINE=langgraph
LANGGRAPH_URL=http://127.0.0.1:5678
COMPANION_ENGINE=langgraph
LANGGRAPH_COMPANION_URL=http://127.0.0.1:5679
# Shift Handover (5680) and Exit KT (5681) default to these URLs when unset:
# LANGGRAPH_HANDOVER_URL=http://127.0.0.1:5680
# LANGGRAPH_EXIT_KT_URL=http://127.0.0.1:5681

# Curriculum source ingestion runs the ai/vector_embedding package with the AI environment.
# Use absolute paths.
INGESTION_PYTHON=/absolute/path/to/repo/ai/.ai_builder_env/bin/python
INGESTION_DIR=/absolute/path/to/repo/ai/vector_embedding

# Notifications: "firestore" uses the emulator from local/compose.yaml; "none" turns delivery off.
# NOTIFICATIONS=firestore
# Work Companion calendar (needs the Google OAuth app in ai/.env); keep false for shared deployments.
# COMPANION_CALENDAR=false
